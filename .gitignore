# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# cloudflare adapter build output + wrangler local state
/.open-next/
/.wrangler/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Serena MCP tool metadata (local, not project config)
.serena/

# Terminal colour artifact, not project state
.termcolor

# Installed tooling, not this project's source. Vendored by `npx impeccable
# install`; 145,000 lines that would otherwise sit in every diff, and already
# excluded from eslint for the same reason. Untracked so the repo stays about
# the app.
.claude/skills/
.github/skills/
.github/agents/
.github/hooks/
