#!/usr/bin/env bash
set -euo pipefail

# Verify a deployed origin actually serves the app. Takes the base URL so the same
# script works for production and for a PR preview.
#
# Checks the things a green build cannot: that prerendered HTML is reachable, that
# the locale middleware survived the adapter, and that EVERY locale renders its own
# copy rather than falling back to English.

BASE="${1:?usage: scripts/smoke <base-url>}"
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
FAILED=0

# The locales — and now each locale's URL PREFIX, since the CA route migration made a
# prefix span two segments ("/ca/en") rather than being the locale itself — come from
# the app's own registry, never from a list written here. This script used to name /en
# and /fr and claim in its own comment that it checked "both locales"; the day a third
# shipped it would have kept passing while covering half the product — a green check
# that checks less than it says is the failure mode this repo spends the most effort on.
#
# Imported DIRECTLY rather than regex-parsed. `src/i18n/countries.ts` exists precisely
# so this can: it has no imports of its own — no `@/` aliases, no next-intl, no JSON,
# no env vars — so Node's type stripping can load it with nothing installed. That is
# also why scripts/assert-prerendered.mjs and scripts/generate-og.mjs import
# `countries.ts` directly rather than `routing.ts`: `routing.ts` needs node_modules
# installed (it imports `next-intl/routing`) AND its own relative import of
# `./countries` is extensionless, which Node's ESM resolver rejects with no bundler in
# front of it — this script in particular runs against a deployed URL from anywhere, so
# neither constraint can hold here. Regex-parsing `locales: [...]` worked while
# routing.ts wrote that array as a literal; the CA migration made it `allLocales()`, a
# real function call a regex cannot evaluate — importing the registry instead of
# scraping its output is what keeps this script from silently narrowing the moment
# routing.ts's shape changes again.
#
# Native type stripping needs Node >= 22.18 or >= 23.6 (no `--experimental-strip-types`
# flag below that, and none is passed here) — it does NOT "run anywhere". CI pins Node
# 24 via `.nvmrc`; run this against an older Node locally and it fails at this
# `import`, not at some later step that would make the real cause hard to find.
#
# The parse is deliberately strict: no match is a hard failure, never an empty list
# quietly checked. That is the same rule assert-prerendered states — go red rather
# than silently stop checking.
#
# The expected copy comes from the catalogues for the same reason: `Home.heading` is
# distinct in every locale, so a page that 200s in English under /ca/uk is caught.
# Punctuation is stripped because accented punctuation and the narrow no-break space
# before French "?" survive into the HTML but make a brittle grep. Catalogues stay one
# file per LANGUAGE (messages/en.json), not per locale pair, so the probe reads
# languageOf(locale).
read -r -d '' PROBE_SCRIPT <<'JS' || true
import { readFileSync } from "node:fs";
import { pathToFileURL } from "node:url";
const root = process.argv[1];
const countriesUrl = pathToFileURL(`${root}/src/i18n/countries.ts`).href;
const { allLocales, localePrefixes, languageOf } = await import(countriesUrl);
const locales = allLocales();
if (!Array.isArray(locales) || locales.length === 0) {
  throw new Error("src/i18n/countries.ts: allLocales() returned no locales");
}
const prefixes = localePrefixes();
const STRIP_PUNCT = new RegExp("[&<>\"'‘’“”¿¡]", "g");
const STRIP_TRAILING = new RegExp("[?!.\\s\\u00a0\\u202f]+$", "u");
for (const locale of locales) {
  const prefix = prefixes[locale];
  if (!prefix) throw new Error(`${locale}: no prefix in localePrefixes()`);
  const messages = JSON.parse(readFileSync(`${root}/messages/${languageOf(locale)}.json`, "utf8"));
  const probe = String(messages.Home.heading)
    .replace(STRIP_PUNCT, "")
    .replace(STRIP_TRAILING, "")
    .trim();
  if (probe.length < 12) throw new Error(`${locale}: probe too short to be distinctive: "${probe}"`);
  console.log(`${locale}\t${prefix}\t${probe}`);
}
JS

if ! PROBES=$(node --input-type=module -e "$PROBE_SCRIPT" "$ROOT"); then
  echo "FAIL  cannot read the locale registry from src/i18n/countries.ts"
  echo "      Without it this script silently narrows to whatever it can reach."
  exit 1
fi

if [ -z "$PROBES" ]; then
  echo "FAIL  src/i18n/countries.ts declared no locales"
  exit 1
fi

# The edge and DNS can lag a fresh deploy; retry rather than flake.
#
# -L follows redirects on purpose: route slugs are localized (/ca/fr/affordability
# redirects to /ca/fr/abordabilite), so asserting "this path returns 200 without
# redirecting" would break every time a slug is translated. What matters is that the
# URL ultimately serves the app.
fetch_status() {
  curl -s -L --max-redirs 5 -o /dev/null -w '%{http_code}' \
    --retry 5 --retry-delay 3 --retry-all-errors --max-time 30 "$1"
}

check_status() {
  local path="$1" status
  status=$(fetch_status "$BASE$path")
  if [ "$status" = "200" ]; then
    echo "ok    $path -> $status"
  else
    echo "FAIL  $path -> $status"
    FAILED=1
  fi
}

# Prints "<status>\t<location>" for the FIRST hop only, reading the raw `Location`
# header the server actually sent -- not curl's %{redirect_url}, which resolves a
# relative Location against the request URL and hands back an absolute one (so
# "/ca/en/affordability" becomes "http://host/ca/en/affordability", which then fails
# any "starts with /ca/en" comparison even on a correct redirect). Next emits a
# relative Location, so this is what a same-prefix check needs to compare against.
redirect_probe() {
  local url="$1" headers status location
  headers=$(curl -s -o /dev/null -D - \
    --retry 5 --retry-delay 3 --retry-all-errors --max-time 30 "$url")
  status=$(printf '%s' "$headers" | head -1 | awk '{print $2}')
  location=$(printf '%s\n' "$headers" | tr -d '\r' | awk 'tolower($1) == "location:" {print $2; exit}')
  printf '%s\t%s\n' "$status" "$location"
}

FR_PREFIX=""
while IFS=$'\t' read -r locale prefix probe; do
  [ -n "$locale" ] || continue
  check_status "$prefix"
  # The canonical key doubles as the English slug and redirects to the localized one,
  # so this exercises the rewrite for every locale, including those with no slug of
  # their own.
  check_status "$prefix/affordability"

  # A 200 that renders the wrong language would pass every check above.
  if curl -s -L --max-redirs 5 --max-time 30 "$BASE$prefix" | grep -qF "$probe"; then
    echo "ok    $prefix renders its own copy"
  else
    echo "FAIL  $prefix did not render its own copy (looked for: $probe)"
    FAILED=1
  fi

  # The PRE-migration URL shape, checked WITHOUT following the redirect (unlike every
  # check above, which uses -L and only proves where a request eventually lands). This
  # is the one check in this script aimed squarely at next.config's redirects() itself:
  # CLAUDE.md records that this repo's actual failure mode is a build and every test
  # passing while a deployed origin silently drops an edge-only behavior — "verify
  # against a deployed response, not the build output." Following -L here would make
  # this indistinguishable from the /affordability check two lines up.
  #
  # CA ONLY. `src/lib/redirects.ts`'s own comment is explicit: `LANG_PATTERN` covers
  # only `ca`'s pre-migration languages, because CA is the only country that ever had a
  # root-level (no-country-segment) URL to be compatible with — a second country never
  # shipped bare `/en/...` links for anyone to have bookmarked. `en` and `es` are each
  # shared by TWO countries today, so this bare form is inherently ambiguous and, by
  # that file's design, always resolves to `/ca/...` — checking it against the US
  # prefix here asserted something that was never true and could not be made true
  # without breaking the CA compatibility redirect for everyone who bookmarked it.
  # Verified once, under CA's own iteration of this loop, is enough.
  case "$prefix" in
    /ca/*) run_legacy_check=1 ;;
    *) run_legacy_check=0 ;;
  esac
  if [ "$run_legacy_check" = "1" ]; then
    lang="${prefix##*/}"
    IFS=$'\t' read -r status location < <(redirect_probe "$BASE/$lang/affordability")
    case "$status" in
      3??)
        case "$location" in
          "$prefix"*)
            echo "ok    /$lang/affordability -> $status $location"
            ;;
          *)
            echo "FAIL  /$lang/affordability -> $status $location (expected Location starting with $prefix)"
            FAILED=1
            ;;
        esac
        ;;
      *)
        echo "FAIL  /$lang/affordability -> $status ${location:-<no redirect>} (expected a 3xx)"
        FAILED=1
        ;;
    esac
  fi

  # French is the one guaranteed to carry a slug (uk carries none; es omits rrsp-hbp's).
  # Scoped to "fr-CA" specifically rather than "any French locale" because this repo
  # serves exactly one country today; a second country with its own French locale would
  # need this generalized alongside the rest of this script.
  if [ "$locale" = "fr-CA" ]; then
    FR_PREFIX="$prefix"
  fi
done <<< "$PROBES"

# RRSP-HBP specifically, in BOTH directions: `ROUTE_COUNTRIES["/rrsp-hbp"]` is the one
# route this app restricts by country today (US-market spec, "absent from the US
# navigation"), and every check above is scoped to "/" and "/affordability", which both
# exist in every country -- so a build that prerendered the WRONG set of route x locale
# pairs (serving RRSP-HBP to the US, or 404-ing it for Canada) would still pass every
# check above. Derived from `routeLocales("/rrsp-hbp", ...)` rather than hardcoded to
# "ca"/"us", so a second restricted route or a third country needs no new script --
# see src/lib/route-guard.ts, the runtime half of this same table.
read -r -d '' RRSP_AVAILABILITY_SCRIPT <<'JS' || true
import { pathToFileURL } from "node:url";
const root = process.argv[1];
const countriesUrl = pathToFileURL(`${root}/src/i18n/countries.ts`).href;
const ogManifestUrl = pathToFileURL(`${root}/src/lib/og-manifest.ts`).href;
const { allLocales, localePrefixes } = await import(countriesUrl);
const { routeLocales } = await import(ogManifestUrl);
const locales = allLocales();
const prefixes = localePrefixes();
const available = new Set(routeLocales("/rrsp-hbp", locales));
for (const locale of locales) {
  console.log(`${prefixes[locale]}\t${available.has(locale) ? "1" : "0"}`);
}
JS

if ! RRSP_PROBES=$(node --input-type=module -e "$RRSP_AVAILABILITY_SCRIPT" "$ROOT"); then
  echo "FAIL  cannot read RRSP-HBP availability from src/lib/og-manifest.ts"
  FAILED=1
  RRSP_PROBES=""
fi

while IFS=$'\t' read -r prefix available; do
  [ -n "$prefix" ] || continue
  path="$prefix/rrsp-hbp"
  status=$(fetch_status "$BASE$path")
  if [ "$available" = "1" ]; then
    if [ "$status" = "200" ]; then
      echo "ok    $path -> 200"
    else
      echo "FAIL  $path -> $status (expected 200 -- ROUTE_COUNTRIES lists this locale's country)"
      FAILED=1
    fi
  else
    if [ "$status" = "404" ]; then
      echo "ok    $path -> 404 (no page for this country)"
    else
      echo "FAIL  $path -> $status (expected 404 -- RRSP-HBP has no page for this country)"
      FAILED=1
    fi
  fi
done <<< "$RRSP_PROBES"

# Bare country segments ("/ca") name no language yet. Without a redirect they fall
# through to next-intl's own locale negotiation, which treats "ca" as an unrecognized
# PATH under the negotiated locale — the recorded defect this line exists to catch:
# /ca -> 307 -> /ca/en/ca -> 404. One rule per COUNTRIES entry sends it to that
# country's own default-language prefix instead (src/lib/redirects.ts), read off the
# registry here rather than hardcoding "/ca" so a second country is covered for free.
read -r -d '' COUNTRY_SCRIPT <<'JS' || true
import { pathToFileURL } from "node:url";
const root = process.argv[1];
const countriesUrl = pathToFileURL(`${root}/src/i18n/countries.ts`).href;
const { COUNTRIES, defaultPrefixes } = await import(countriesUrl);
const defaults = defaultPrefixes();
for (const country of Object.keys(COUNTRIES)) {
  console.log(`${COUNTRIES[country].segment}\t${defaults[country]}`);
}
JS

if ! COUNTRY_PROBES=$(node --input-type=module -e "$COUNTRY_SCRIPT" "$ROOT"); then
  echo "FAIL  cannot read the country registry from src/i18n/countries.ts"
  exit 1
fi

while IFS=$'\t' read -r segment default_prefix; do
  [ -n "$segment" ] || continue
  # Must ultimately resolve, through its own redirect and then next-intl's, to a real
  # prerendered page -- not 404 through an unrecognized-path redirect.
  check_status "$segment"

  # And it must resolve there directly: the Location on the FIRST hop has to be the
  # country's own default-language prefix, not merely "some page 200s eventually."
  IFS=$'\t' read -r status location < <(redirect_probe "$BASE$segment")
  case "$status" in
    3??)
      case "$location" in
        "$default_prefix"*)
          echo "ok    $segment -> $status $location"
          ;;
        *)
          echo "FAIL  $segment -> $status $location (expected Location starting with $default_prefix)"
          FAILED=1
          ;;
      esac
      ;;
    *)
      echo "FAIL  $segment -> $status ${location:-<no redirect>} (expected a 3xx)"
      FAILED=1
      ;;
  esac
done <<< "$COUNTRY_PROBES"

if [ -z "$FR_PREFIX" ]; then
  echo "FAIL  fr-CA is not in the locale registry; cannot verify Accept-Language negotiation"
  FAILED=1
else
  # The locale redirect is the only dynamic surface; if the middleware did not survive
  # the adapter, this is where it shows. One non-default locale is enough to prove
  # negotiation works at all.
  redirect=$(curl -s -o /dev/null -w '%{redirect_url}' -H 'Accept-Language: fr-CA,fr;q=0.9' \
    --retry 5 --retry-delay 3 --retry-all-errors --max-time 30 "$BASE/")
  case "$redirect" in
    *"$FR_PREFIX") echo "ok    / (Accept-Language: fr) -> $redirect" ;;
    *)             echo "FAIL  / (Accept-Language: fr) -> ${redirect:-<none>}"; FAILED=1 ;;
  esac
fi

exit "$FAILED"
