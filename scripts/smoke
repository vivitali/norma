#!/usr/bin/env bash
set -euo pipefail

# Verify a deployed origin actually serves the app. Takes the base URL so the same
# script works for production and for a PR preview.
#
# Checks the things a green build cannot: that prerendered HTML is reachable, that
# the locale middleware survived the adapter, and that both locales render.

BASE="${1:?usage: scripts/smoke <base-url>}"
FAILED=0

# The edge and DNS can lag a fresh deploy; retry rather than flake.
fetch_status() {
  curl -s -o /dev/null -w '%{http_code}' --retry 5 --retry-delay 3 --retry-all-errors --max-time 30 "$1"
}

for path in /en /fr /en/affordability /fr/affordability; do
  status=$(fetch_status "$BASE$path")
  if [ "$status" = "200" ]; then
    echo "ok    $path -> $status"
  else
    echo "FAIL  $path -> $status"
    FAILED=1
  fi
done

# The locale redirect is the only dynamic surface; if the middleware did not survive
# the adapter, this is where it shows.
redirect=$(curl -s -o /dev/null -w '%{redirect_url}' -H 'Accept-Language: fr-CA,fr;q=0.9' \
  --retry 5 --retry-delay 3 --retry-all-errors --max-time 30 "$BASE/")
case "$redirect" in
  */fr) echo "ok    / (Accept-Language: fr) -> $redirect" ;;
  *)    echo "FAIL  / (Accept-Language: fr) -> ${redirect:-<none>}"; FAILED=1 ;;
esac

# A 200 that renders the wrong language would pass every check above.
if curl -s --max-time 30 "$BASE/fr" | grep -q "vraiment vous permettre"; then
  echo "ok    /fr renders French"
else
  echo "FAIL  /fr did not render French copy"
  FAILED=1
fi

exit "$FAILED"
