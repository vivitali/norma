#!/usr/bin/env bash
set -euo pipefail

cd "$(dirname "$0")/.."

# Every page route must be prerendered: every page request runs the Worker, and
# prerendering is what keeps that invocation an asset read instead of React SSR
# under the Free plan's 10ms CPU cap (see CLAUDE.md). A page that loses its
# prerendering still renders correctly, so only a build-time assertion catches it.
#
# Separate from scripts/check because `next build` takes a per-project lock and
# scripts/check runs from a post-edit hook — see the note there.

./scripts/build

# --disable-warning silences only MODULE_TYPELESS_PACKAGE_JSON, emitted because the
# guard imports src/i18n/routing.ts directly (Node strips the types). Scoped to that
# one code so genuine warnings still surface.
node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/assert-prerendered.mjs
